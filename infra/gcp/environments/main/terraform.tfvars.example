# Fictional identifiers and illustrative limits; no measured capacity or budget.
terraform_service_account = "terraform-main@rangle-example-main.iam.gserviceaccount.com"
config = {
  project_id                = "rangle-example-main"
  project_number            = "123456789012"
  region                    = "us-central1"
  name_prefix               = "rangle"
  app_domain                = "main.app.example.com"
  media_domain              = "main.media.example.com"
  media_bucket_name         = "rangle-example-main-published"
  catalog_bucket_name       = "rangle-example-main-catalog"
  input_bucket_name         = "rangle-example-main-private-inputs"
  publisher_service_account = "publisher-main@rangle-example-main.iam.gserviceaccount.com"
  media_cache_ttl_seconds   = 86400
}

# First stage: creates storage and the media edge only; do not set app DNS yet.
application = null

