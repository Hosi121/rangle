main:
  params: [args]
  steps:
    - initialize:
        assign:
          - stop: false
          - reason: "not_due"
          - ack_ids: []
          - errors: []
          - observed_cost: null
          - operation_name: null
    - deadline:
        switch:
          - condition: $${sys.now() >= time.parse("${deadline}")}
            steps:
              - expired:
                  assign:
                    - stop: true
                    - reason: "deadline"
                  next: stop_decision
    - pull_budget:
        call: http.post
        args:
          url: "https://pubsub.googleapis.com/v1/${subscription}:pull"
          auth: {type: OAuth2}
          body:
            maxMessages: 10
            returnImmediately: true
        result: pulled
    - inspect_updates:
        for:
          value: received
          in: $${default(map.get(pulled.body, "receivedMessages"), [])}
          steps:
            - decode_update:
                assign:
                  - update: $${json.decode(base64.decode(received.message.data))}
            - match_owned_budget:
                switch:
                  - condition: $${map.get(update, "budgetDisplayName") != "${budget_display_name}"}
                    next: collect_ack
                  - condition: $${map.get(update, "currencyCode") != "${budget_currency}"}
                    steps:
                      - invalid_currency:
                          raise: "Budget currency mismatch; do not silently convert amounts"
            - evaluate_cost:
                assign:
                  - observed_cost: $${double(update.costAmount)}
            - limit:
                switch:
                  - condition: $${observed_cost >= ${stop_amount}}
                    steps:
                      - reached:
                          assign:
                            - stop: true
                            - reason: "budget"
            - collect_ack:
                assign:
                  - ack_ids: $${list.concat(ack_ids, received.ackId)}
    - stop_decision:
        switch:
          - condition: $${not stop}
            next: acknowledge
    - disable_deployer:
        try:
          call: http.post
          args:
            url: "https://iam.googleapis.com/v1/${deployer}:disable"
            auth: {type: OAuth2}
            body: {}
        except:
          as: error
          steps:
            - record_deployer_error:
                assign:
                  - errors: $${list.concat(errors, error)}
    - disable_hosting:
        try:
          call: http.post
          args:
            url: "https://firebasehosting.googleapis.com/v1beta1/sites/${site}/releases"
            auth: {type: OAuth2}
            body:
              type: "SITE_DISABLE"
              message: "Presentation deadline or budget stop"
        except:
          as: error
          steps:
            - record_hosting_error:
                assign:
                  - errors: $${list.concat(errors, error)}
    - inspect_before_delete:
        call: service_is_absent
        args:
          url: "https://run.googleapis.com/v2/${service}"
        result: already_absent
    - skip_missing_service:
        switch:
          - condition: $${already_absent}
            next: verify_service_absent
    - delete_owned_service:
        try:
          steps:
            - request_deletion:
                call: http.delete
                args:
                  url: "https://run.googleapis.com/v2/${service}"
                  auth: {type: OAuth2}
                result: deletion
            - remember_operation:
                assign:
                  - operation_name: $${deletion.body.name}
        except:
          as: error
          steps:
            - accept_absent_service:
                switch:
                  - condition: $${map.get(error, "code") == 404}
                    next: verify_service_absent
            - record_service_error:
                assign:
                  - errors: $${list.concat(errors, error)}
    - wait_for_deletion_operation:
        call: wait_until_operation_done
        args:
          operation_name: $${operation_name}
        result: operation_ok
    - verify_operation:
        switch:
          - condition: $${not operation_ok}
            steps:
              - operation_failed:
                  assign:
                    - errors: $${list.concat(errors, "Owned service deletion operation failed or timed out")}
    - verify_service_absent:
        call: wait_until_absent
        args:
          url: "https://run.googleapis.com/v2/${service}"
        result: service_absent
    - verify_deletion:
        switch:
          - condition: $${not service_absent}
            steps:
              - deletion_failed:
                  assign:
                    - errors: $${list.concat(errors, "Service deletion was not confirmed")}
    - check_shutdown:
        switch:
          - condition: $${len(errors) > 0}
            steps:
              - shutdown_failed:
                  raise: $${json.encode_to_string(errors)}
    - persist_receipt:
        try:
          call: http.post
          args:
            url: "https://storage.googleapis.com/upload/storage/v1/b/${receipt_bucket}/o"
            query:
              uploadType: "media"
              name: "guard/presentation-stop.json"
              ifGenerationMatch: "0"
            auth: {type: OAuth2}
            headers: {Content-Type: "application/json"}
            body: '$${json.encode_to_string({"reason": reason, "observed_cost": observed_cost, "currency": "${budget_currency}", "time": time.format(sys.now()), "site": "${site}", "service": "${service}"})}'
        except:
          as: error
          steps:
            - existing_receipt:
                switch:
                  - condition: $${map.get(error, "code") == 412}
                    next: acknowledge
            - receipt_failed:
                raise: $${error}
    - acknowledge:
        switch:
          - condition: $${len(ack_ids) > 0}
            steps:
              - acknowledge_updates:
                  call: http.post
                  args:
                    url: "https://pubsub.googleapis.com/v1/${subscription}:acknowledge"
                    auth: {type: OAuth2}
                    body:
                      ackIds: $${ack_ids}
    - pause_after_stop:
        switch:
          - condition: $${stop}
            steps:
              - pause_own_scheduler:
                  call: http.post
                  args:
                    url: "https://cloudscheduler.googleapis.com/v1/${scheduler}:pause"
                    auth: {type: OAuth2}
                    body: {}
    - result:
        return: '$${{"stopped": stop, "reason": reason, "observed_cost": observed_cost}}'

wait_until_absent:
  params: [url]
  steps:
    - initialize:
        assign:
          - attempts: 0
    - inspect:
        try:
          call: http.get
          args:
            url: $${url}
            auth: {type: OAuth2}
        except:
          as: error
          steps:
            - missing:
                switch:
                  - condition: $${map.get(error, "code") == 404}
                    steps:
                      - confirmed_absent:
                          return: true
            - unavailable:
                return: false
    - increment:
        assign:
          - attempts: $${attempts + 1}
    - bounded_wait:
        switch:
          - condition: $${attempts >= 60}
            steps:
              - verification_timed_out:
                  return: false
    - wait:
        call: sys.sleep
        args: {seconds: 5}
        next: inspect

service_is_absent:
  params: [url]
  steps:
    - inspect:
        try:
          call: http.get
          args:
            url: $${url}
            auth: {type: OAuth2}
        except:
          as: error
          steps:
            - missing:
                switch:
                  - condition: $${map.get(error, "code") == 404}
                    steps:
                      - absent:
                          return: true
            - unauthorized:
                raise: $${error}
    - present:
        return: false

wait_until_operation_done:
  params: [operation_name]
  steps:
    - validate_name:
        switch:
          - condition: $${operation_name == null}
            steps:
              - missing_operation:
                  return: false
          - condition: $${not text.match_regex(operation_name, "^${operation_prefix}[A-Za-z0-9_-]+$")}
            steps:
              - foreign_operation:
                  raise: "Unexpected Cloud Run operation resource name"
    - initialize:
        assign:
          - attempts: 0
    - inspect:
        try:
          call: http.get
          args:
            url: $${"https://run.googleapis.com/v2/" + operation_name}
            auth: {type: OAuth2}
          result: operation
        except:
          as: error
          steps:
            - operation_error:
                return: false
    - done:
        switch:
          - condition: $${default(map.get(operation.body, "done"), false)}
            steps:
              - successful:
                  return: $${map.get(operation.body, "error") == null}
    - increment:
        assign:
          - attempts: $${attempts + 1}
    - bounded_wait:
        switch:
          - condition: $${attempts >= 120}
            steps:
              - operation_timed_out:
                  return: false
    - wait:
        call: sys.sleep
        args: {seconds: 5}
        next: inspect
